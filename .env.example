# ============================================================
# AURA Atelier - Configuracion local
# Copia este archivo como .env y ajusta los valores si es necesario.
# Los scripts de Windows crean .env automaticamente si no existe.
# ============================================================

APP_NAME="AURA Atelier | Tienda de Ropa en Linea"
APP_URL=http://localhost:8000
APP_ENV=local

# Base de datos PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tienda_ropa_db
DB_USER=postgres
DB_PASS=postgres

# Backend (API REST + reportes)
BACKEND_HOST=127.0.0.1
# 8080 suele estar ocupado por Apache de XAMPP; usa 8081 o libera el 8080.
BACKEND_PORT=8081

# Frontend (tienda web)
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8000

# Opcional: si no se definen, se construyen con BACKEND_HOST + BACKEND_PORT.
# BACKEND_API_URL=http://127.0.0.1:8081
# BACKEND_REPORTS_URL=http://127.0.0.1:8081/reports
# BACKEND_TIMEOUT=10

# Bloqueo de sesión única por cuenta (frontend)
# Tiempo máximo sin actividad antes de liberar la cuenta (segundos).
# SESSION_LOCK_TTL=1800
# Cada cuánto se refresca la actividad del navegador (segundos).
# SESSION_TOUCH_INTERVAL=300
# Opcional: ruta personalizada del registro de sesiones activas.
# SESSION_REGISTRY_FILE=C:\ruta\active_sessions.json

# Pasarela de pago: simulated | stripe
PAYMENT_GATEWAY=simulated
STRIPE_KEY=pk_test_sample
STRIPE_SECRET=sk_test_sample

# Rutas de herramientas en Windows (opcional, para equipos sin PATH)
# PHP_BIN=C:\xampp\php\php.exe
# PSQL_BIN=C:\Program Files\PostgreSQL\17\bin\psql.exe
# COMPOSER_PHAR=C:\ProgramData\ComposerSetup\bin\composer.phar
